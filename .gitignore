# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# JS bundle build (node_modules regenerated by `npm install`; the built
# bundle at assets/js/yjs_bridge.js is committed since flutter_js loads it
# as an asset and no npm/node toolchain runs at app-build time)
js/node_modules/

# Human-session diagnostics. The probe app writes one of these every time the
# operator uses the JSON-log feature, so they accumulate in reports/ alongside
# the committed measurement reports. Those reports ARE tracked on purpose --
# `git diff reports/` is the only thing that catches silent number drift when a
# scenario's measurement changes without any assertion going red. Letting
# session dumps into the same directory untracked would train everyone to
# ignore a dirty reports/, which is exactly the signal that must stay clean.
reports/human-session-*.json

# subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Rust/Cargo build artifacts (native bindings)
native/yrs-src/target/
